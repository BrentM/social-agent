# Twitter/X API Credentials
# Copy this file to .env and fill in your keys
# NEVER commit .env to git

API_KEY=your_api_key_here
API_KEY_SECRET=your_api_key_secret_here
ACCESS_TOKEN=your_access_token_here
ACCESS_TOKEN_SECRET=your_access_token_secret_here
BEARER_TOKEN=your_bearer_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
CONSUMER_KEY=your_consumer_key_here
CONSUMER_KEY_SECRET=your_consumer_key_secret_here

# Playground / Local Mock (https://github.com/xdevplatform/playground)
# Set X_API_BASE_URL to point tweepy at the local playground server instead of api.twitter.com.
# Leave unset (or empty) to use the real Twitter/X API.
# X_API_BASE_URL=http://localhost:8080

# Bot Settings
BOT_USERNAME=YourBotHandle
POST_TIMES=08:00,13:00,19:00
MAX_DAILY_FOLLOWS=20
REPLY_POLL_MINUTES=15

# Optional: Claude API for dynamic replies
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Supabase
# Get these from your Supabase project: Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
